<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.6.4</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>tr.com.tatmetal</groupId>
    <artifactId>message-proxy</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>message-proxy</name>
    <description>Gelen REST mesajını tanımlı hedefe REST olarak ileten proxy servis</description>

    <properties>
        <!-- Spring Boot 2.6.x en fazla Java 17'yi destekler -->
        <java.version>17</java.version>
        <!-- Spring Cloud 2021.0.x (Jubilee): Spring Boot 2.6.x ile uyumlu -->
        <spring-cloud.version>2021.0.1</spring-cloud.version>
        <!-- Kurum içi mini_jpa kütüphanesi: kendi Nexus/Artifactory sürümünüzle güncelleyin -->
        <mini-jpa.version>1.0.0</mini-jpa.version>
    </properties>

    <dependencies>
        <!-- REST API -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Veritabanı: JDBC + PostgreSQL -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- mini_jpa @ExtendsBaseEntity gibi AOP tabanlı anotasyonlar için -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- Kurum içi mini_jpa -->
        <dependency>
            <groupId>tr.com.zenergy</groupId>
            <artifactId>mini-jpa</artifactId>
            <version>0.0.341</version>
        </dependency>
        <dependency>
            <groupId>tr.com.zenergy.exss</groupId>
            <artifactId>exss-service</artifactId>
            <version>0.0.67</version>
        </dependency>

        <!-- Route + alan eşleştirme tanımlarının önbelleği: Redis -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- REST çağrıları: OpenFeign -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <!-- Apache HttpClient 5: PATCH desteği ve connection pool için -->
        <dependency>
            <groupId>io.github.openfeign</groupId>
            <artifactId>feign-hc5</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
    <repositories>
        <repository>
            <id>github</id>
            <url>https://maven.pkg.github.com/bahadirsezgun/zenergy-*</url>
        </repository>
    </repositories>
</project>
